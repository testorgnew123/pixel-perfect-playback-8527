# Secrets live in .env.local (git-ignored) — see README.md for the required vars.

# Public site origin, used for canonical URLs, hreflang, og:url and the sitemap.
# Not a secret, so it can live here; override per deploy (Netlify env) when the host differs.
VITE_SITE_URL=https://harishivshankartirthyatra.com/

# Outgoing mail (BigRock / cPanel mailbox). Values are per-environment; keep the password
# in .env.local and in the Netlify UI, never here.
#   SMTP_HOST=mail.harishivshankartirthyatra.com
#   SMTP_PORT=465        # 465 = implicit TLS, 587 = STARTTLS
#   SMTP_SECURE=true     # defaults to true when the port is 465
#   SMTP_USER=noreply@harishivshankartirthyatra.com
#   SMTP_PASS=
#   EMAIL_FROM="Hari Shiv Shankar Tirth Yatra <noreply@harishivshankartirthyatra.com>"
